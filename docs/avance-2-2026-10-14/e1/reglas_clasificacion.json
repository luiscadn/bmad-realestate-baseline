{
  "standard": "ISO/IEC 25010:2023",
  "source": "https://www.iso.org/standard/78176.html",
  "categories": [
    "functional_suitability",
    "performance_efficiency",
    "compatibility",
    "interaction_capability",
    "reliability",
    "security",
    "maintainability",
    "flexibility",
    "safety"
  ],
  "rules": [
    {
      "category": "process_traceability",
      "regex": "sprint.status|spec.{0,35}status|status.{0,30}(?:spec|review|done)|triage.{0,30}(?:missing|record)|review.{0,30}(?:skipped|not launched)|claimed.{0,25}(?:pass|build)|claim.{0,25}unverified|no committed evidence|spec filename|acceptance criteria.{0,25}(?:empty|missing)",
      "reason": "P01: observación del proceso; no se fuerza a una característica de producto."
    },
    {
      "category": "security",
      "regex": "\\brls\\b|authoriz|unauthoriz|authentica|service.role|row.level|\\bcsrf\\b|\\bxss\\b|injection|permission|cross.agent|password|\\bpii\\b|sensitive|search_path|token|session|rate.limit|captcha|privacy|consent|expos|access.control",
      "reason": "S01: acceso, autorización, abuso, privacidad o protección de datos."
    },
    {
      "category": "interaction_capability",
      "regex": "aria|screen.reader|a11y|accessib|focus|alt.text|keyboard|landmark|tabindex|contrast|i18n|localiz|locale|translat|next.intl|hard.coded.{0,25}(?:string|quote|text)|currency.format|visual|viewport|responsive|accessible.name|user.experience",
      "reason": "I01: interacción, comprensión, accesibilidad o adecuación lingüística de la interfaz."
    },
    {
      "category": "maintainability",
      "regex": "\\btest|assert|coverage|mock|readab|duplicat|hard.cod|dead.code|type.safe|typescript|\\bany\\b|modular|magic.number|maintain|lint|code.quality",
      "reason": "M01: capacidad de análisis, modificación o prueba del código."
    },
    {
      "category": "reliability",
      "regex": "race|out.of.order|stale|unmount|cleanup|leak|timer|interval|abort|hang|timeout|unhandled|retry|network.failure|network.error|double.submit|concurrent|idempot|resilien|fault|loading.state",
      "reason": "R01: consistencia del estado y comportamiento ante concurrencia o fallo."
    },
    {
      "category": "performance_efficiency",
      "regex": "index|performance|expensive|\\bn\\+1\\b|latency|resource.use|memory|full.table|query.plan|trigram|full.text|unbounded|large.payload",
      "reason": "E01: tiempo de respuesta, capacidad o consumo de recursos."
    },
    {
      "category": "compatibility",
      "regex": "browser|safari|compatib|version.{0,25}(?:schema|supabase)|supabase.{0,25}upgrade|integration.contract|interoperab",
      "reason": "C01: coexistencia o interoperabilidad entre componentes y plataformas."
    },
    {
      "category": "flexibility",
      "regex": "portab|adaptab|installab|deployment|environment|env.var|configur|platform",
      "reason": "F01: adaptación, instalación o cambio de entorno."
    },
    {
      "category": "functional_suitability",
      "regex": "validat|invalid|regex|constraint|input|return|error|404|400|409|500|missing|incorrect|wrong|allow|reject|check|sort|filter|slug|date|timestamp|timezone|time.zone|calculation|precision|round|empty|no |cannot|can.t|does not|not ",
      "reason": "U01: adecuación, corrección o completitud del comportamiento funcional."
    }
  ],
  "assisted_case_decisions": {
